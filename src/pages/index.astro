---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main>
			<h1>Mona Mayhem - GitHub Contribution Battle Arena</h1>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="field">
						<label for="player1">Player 1</label>
						<input
							id="player1"
							name="player1"
							type="text"
							autocomplete="off"
							spellcheck="false"
							placeholder="octocat"
						/>
					</div>
					<div class="field">
						<label for="player2">Player 2</label>
						<input
							id="player2"
							name="player2"
							type="text"
							autocomplete="off"
							spellcheck="false"
							placeholder="torvalds"
						/>
					</div>
				</div>
				<button id="battle-button" type="submit">Battle</button>
			</form>

			<section id="results" aria-live="polite" aria-atomic="true"></section>
		</main>

		<style is:global>
			:root {
				--bg: #0a0a1a;
				--bg-panel: #14142b;
				--bg-panel-alt: #1b1b38;
				--green: #5fed83;
				--purple: #8a2be2;
				--focus-core: #f5f7ff;
				--focus-ring: #c184ff;
				--border: #3a3a63;
				--text: #e9e9f5;
				--text-dim: #a9a9cc;
				--error: #ff6b81;
			}

			body {
				position: relative;
				margin: 0;
				padding: 2rem 1rem;
				font-family: 'Press Start 2P', system-ui, sans-serif;
				line-height: 1.6;
				color: var(--text);
				background: var(--bg);
				overflow-x: hidden;
			}

			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background: repeating-linear-gradient(
					to bottom,
					rgba(255, 255, 255, 0.05) 0,
					rgba(255, 255, 255, 0.05) 1px,
					transparent 1px,
					transparent 3px
				);
				animation: scanline-drift 9s linear infinite;
			}

			@keyframes scanline-drift {
				from {
					background-position: 0 0;
				}
				to {
					background-position: 0 60px;
				}
			}

			main {
				position: relative;
				z-index: 1;
				max-width: 40rem;
				margin: 0 auto;
			}

			h1 {
				margin: 0 0 1.5rem;
				font-size: 1.1rem;
				line-height: 1.6;
				color: var(--green);
				text-shadow:
					0 0 4px var(--green),
					0 0 10px var(--green),
					0 0 20px var(--purple);
				animation: neon-pulse 3s ease-in-out infinite, neon-flicker 6s linear infinite;
			}

			@keyframes neon-pulse {
				0%,
				100% {
					text-shadow:
						0 0 4px var(--green),
						0 0 10px var(--green),
						0 0 20px var(--purple);
				}
				50% {
					text-shadow:
						0 0 2px var(--green),
						0 0 6px var(--green),
						0 0 12px var(--purple);
				}
			}

			/* Occasional brief dips in opacity/glow to mimic an unstable neon tube. */
			@keyframes neon-flicker {
				0%,
				3%,
				6%,
				100% {
					opacity: 1;
				}
				4% {
					opacity: 0.4;
				}
				5% {
					opacity: 0.85;
				}
				41% {
					opacity: 1;
				}
				42% {
					opacity: 0.5;
				}
				43% {
					opacity: 1;
				}
				77% {
					opacity: 1;
				}
				78% {
					opacity: 0.6;
				}
				79% {
					opacity: 0.9;
				}
				80% {
					opacity: 1;
				}
			}

			.players {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}

			.field {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				animation: float-in 0.6s ease-out backwards;
			}

			.field:nth-child(2) {
				animation-delay: 0.1s;
			}

			@keyframes float-in {
				from {
					opacity: 0;
					transform: translateY(12px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			label {
				font-size: 0.6rem;
				color: var(--text-dim);
			}

			input {
				padding: 0.6rem;
				font: inherit;
				font-size: 0.7rem;
				border: 1px solid var(--border);
				border-radius: 4px;
				background: var(--bg-panel);
				color: var(--text);
				transition:
					border-color 0.15s ease,
					box-shadow 0.15s ease,
					background-color 0.15s ease;
			}

			input[aria-invalid='true'] {
				border-color: var(--error);
				background: linear-gradient(180deg, rgba(255, 107, 129, 0.12), var(--bg-panel));
				box-shadow:
					0 0 0 1px rgba(255, 107, 129, 0.45),
					0 0 10px rgba(255, 107, 129, 0.28);
			}

			input:focus-visible,
			button:focus-visible {
				outline: 2px solid var(--focus-core);
				outline-offset: 3px;
				border-color: var(--focus-ring);
				box-shadow:
					0 0 0 2px rgba(10, 10, 26, 0.95),
					0 0 0 5px rgba(138, 43, 226, 0.7),
					0 0 14px rgba(95, 237, 131, 0.55),
					0 0 24px rgba(138, 43, 226, 0.45);
			}

			button {
				margin-top: 1rem;
				padding: 0.8rem 1.5rem;
				font: inherit;
				font-size: 0.75rem;
				border: 1px solid var(--green);
				border-radius: 4px;
				background: var(--green);
				color: #0a0a1a;
				cursor: pointer;
				transition:
					transform 0.15s ease,
					box-shadow 0.15s ease,
					background-color 0.15s ease;
			}

			button:disabled {
				opacity: 0.6;
				cursor: progress;
			}

			#results {
				margin-top: 1.5rem;
			}

			.status {
				margin: 0;
				font-size: 0.7rem;
			}

			.status.error {
				color: var(--error);
				font-weight: 700;
				padding: 0.75rem 0.85rem;
				border: 1px solid rgba(255, 107, 129, 0.55);
				border-radius: 6px;
				background:
					linear-gradient(180deg, rgba(255, 107, 129, 0.16), rgba(255, 107, 129, 0.06)),
					var(--bg-panel);
				text-shadow:
					0 0 4px rgba(255, 107, 129, 0.95),
					0 0 10px rgba(255, 107, 129, 0.7),
					0 0 18px rgba(255, 107, 129, 0.4);
				box-shadow:
					0 0 0 1px rgba(255, 107, 129, 0.2),
					0 0 14px rgba(255, 107, 129, 0.12);
				animation:
					error-shake 0.28s ease-in-out 1,
					error-flare 0.75s ease-out 1;
			}

			.status.loading {
				animation: loading-shift 1.6s ease-in-out infinite;
			}

			@keyframes error-shake {
				0%,
				100% {
					transform: translateX(0);
				}
				20% {
					transform: translateX(-4px);
				}
				40% {
					transform: translateX(4px);
				}
				60% {
					transform: translateX(-3px);
				}
				80% {
					transform: translateX(3px);
				}
			}

			@keyframes error-flare {
				0% {
					opacity: 0.88;
					text-shadow:
						0 0 2px rgba(255, 107, 129, 0.75),
						0 0 5px rgba(255, 107, 129, 0.55),
						0 0 10px rgba(255, 107, 129, 0.25);
					box-shadow:
						0 0 0 1px rgba(255, 107, 129, 0.2),
						0 0 8px rgba(255, 107, 129, 0.1);
				}
				50% {
					opacity: 1;
					text-shadow:
						0 0 5px rgba(255, 107, 129, 1),
						0 0 14px rgba(255, 107, 129, 0.85),
						0 0 28px rgba(255, 107, 129, 0.55);
					box-shadow:
						0 0 0 1px rgba(255, 107, 129, 0.35),
						0 0 22px rgba(255, 107, 129, 0.2);
				}
				100% {
					opacity: 1;
					text-shadow:
						0 0 4px rgba(255, 107, 129, 0.95),
						0 0 10px rgba(255, 107, 129, 0.7),
						0 0 18px rgba(255, 107, 129, 0.4);
					box-shadow:
						0 0 0 1px rgba(255, 107, 129, 0.2),
						0 0 14px rgba(255, 107, 129, 0.12);
				}
			}

			@keyframes loading-shift {
				0%,
				100% {
					color: var(--green);
					opacity: 1;
				}
				50% {
					color: var(--purple);
					opacity: 0.7;
				}
			}

			.cards {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				align-items: center;
				gap: 1rem;
			}

			.card {
				position: relative;
				overflow: hidden;
				padding: 1rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg-panel);
				animation: float-in 0.5s ease-out backwards;
			}

			.card::after {
				content: '';
				position: absolute;
				top: 0;
				left: -60%;
				width: 40%;
				height: 100%;
				background: linear-gradient(
					115deg,
					transparent 0%,
					rgba(255, 255, 255, 0.16) 45%,
					rgba(255, 255, 255, 0.16) 55%,
					transparent 100%
				);
				animation: shimmer-sweep 3.5s ease-in-out infinite;
				pointer-events: none;
			}

			@keyframes shimmer-sweep {
				0% {
					left: -60%;
				}
				100% {
					left: 130%;
				}
			}

			.card h2 {
				margin: 0 0 0.5rem;
				font-size: 0.75rem;
				color: var(--text);
			}

			.total {
				font-size: 1.4rem;
				font-weight: 700;
				margin: 0;
				color: var(--green);
			}

			.range {
				margin: 0.5rem 0 0;
				font-size: 0.55rem;
				line-height: 1.6;
				color: var(--text-dim);
			}

			.graph-scroll {
				margin-top: 1rem;
				overflow-x: auto;
				padding: 0.25rem 0 0.5rem;
			}

			.contribution-graph {
				display: grid;
				grid-template-rows: repeat(7, 10px);
				grid-auto-flow: column;
				grid-auto-columns: 10px;
				gap: 3px;
				width: max-content;
			}

			.contribution-day {
				width: 10px;
				height: 10px;
				border-radius: 2px;
				cursor: help;
				outline: none;
				transition: box-shadow 0.15s ease, transform 0.15s ease;
			}

			.contribution-day:hover,
			.contribution-day:focus-visible {
				box-shadow: 0 0 6px 1px var(--green);
				transform: scale(1.2);
			}

			.contribution-day:focus-visible {
				outline: 2px solid var(--focus-core);
				outline-offset: 2px;
				box-shadow:
					0 0 0 2px rgba(10, 10, 26, 0.95),
					0 0 0 4px rgba(138, 43, 226, 0.9),
					0 0 8px 2px rgba(95, 237, 131, 0.85),
					0 0 16px 4px rgba(138, 43, 226, 0.65);
			}

			.vs-badge {
				display: grid;
				place-items: center;
				width: 2.5rem;
				height: 2.5rem;
				border-radius: 50%;
				border: 1px solid var(--border);
				background: linear-gradient(90deg, var(--green), var(--purple), var(--green));
				background-size: 200% 100%;
				animation:
					vs-gradient-shift 2.5s linear infinite,
					vs-pulse 1.2s ease-in-out infinite;
				color: #0a0a1a;
				font-weight: 700;
				font-size: 0.6rem;
			}

			@keyframes vs-gradient-shift {
				from {
					background-position: 0% 50%;
				}
				to {
					background-position: 200% 50%;
				}
			}

			/* Dramatic scale + glow pulse layered on top of the gradient shift. */
			@keyframes vs-pulse {
				0%,
				100% {
					transform: scale(1);
					box-shadow:
						0 0 6px 1px var(--green),
						0 0 12px 3px var(--purple);
				}
				50% {
					transform: scale(1.25);
					box-shadow:
						0 0 14px 4px var(--green),
						0 0 26px 8px var(--purple);
				}
			}

			.outcome {
				margin-top: 1rem;
				font-size: 0.75rem;
				font-weight: 700;
				color: var(--green);
			}

			@media (max-width: 64rem) {
				.cards {
					grid-template-columns: minmax(0, 1fr);
					gap: 1.25rem;
				}

				.vs-badge {
					margin: 0 auto;
				}
			}

			@media (max-width: 36rem) {
				.players {
					grid-template-columns: 1fr;
					gap: 0.75rem;
				}

				.vs-badge {
					margin: 0 auto;
				}

				button {
					width: 100%;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				body::before {
					animation: none;
				}

				h1 {
					animation: none;
					opacity: 1;
					text-shadow:
						0 0 4px var(--green),
						0 0 10px var(--green),
						0 0 20px var(--purple);
				}

				.field,
				.card {
					animation: none;
				}

				.card::after {
					animation: none;
					display: none;
				}

				.vs-badge {
					animation: none;
					background-position: 0% 50%;
					transform: scale(1);
					box-shadow:
						0 0 6px 1px var(--green),
						0 0 12px 3px var(--purple);
				}

				.status.loading {
					animation: none;
					color: var(--green);
				}

				.status.error {
					animation: none;
				}

				.contribution-day {
					transition: none;
				}
			}
		</style>

		<script>
			interface ContributionDay {
				weekday: number;
				count: number;
				level: number;
			}

			interface ContributionWeek {
				first_day: string;
				contribution_days: ContributionDay[];
			}

			interface ContributionData {
				total_contributions: number;
				from: string;
				to: string;
				colors_full: string[];
				weeks: ContributionWeek[];
			}

			interface ApiError {
				error: string;
			}

			const form = document.getElementById('battle-form') as HTMLFormElement;
			const button = document.getElementById('battle-button') as HTMLButtonElement;
			const player1Input = document.getElementById('player1') as HTMLInputElement;
			const player2Input = document.getElementById('player2') as HTMLInputElement;
			const results = document.getElementById('results') as HTMLElement;

			function setFieldInvalidState(input: HTMLInputElement, isInvalid: boolean) {
				if (isInvalid) {
					input.setAttribute('aria-invalid', 'true');
					return;
				}

				input.removeAttribute('aria-invalid');
			}

			function showStatus(message: string, state: 'default' | 'error' | 'loading' = 'default') {
				results.innerHTML = '';
				const paragraph = document.createElement('p');
				paragraph.className = state === 'default' ? 'status' : `status ${state}`;
				paragraph.textContent = message;
				results.append(paragraph);
			}

			async function fetchContributions(username: string): Promise<ContributionData> {
				const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
				const payload = (await response.json()) as ContributionData | ApiError;

				if (!response.ok) {
					const message = (payload as ApiError).error ?? 'Request failed.';
					throw new Error(`${username}: ${message}`);
				}

				return payload as ContributionData;
			}

			function formatDate(date: Date): string {
				return new Intl.DateTimeFormat('en', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					timeZone: 'UTC'
				}).format(date);
			}

			function buildGraph(data: ContributionData): HTMLElement {
				const scrollArea = document.createElement('div');
				scrollArea.className = 'graph-scroll';

				const graph = document.createElement('div');
				graph.className = 'contribution-graph';
				graph.setAttribute(
					'aria-label',
					`${data.total_contributions.toLocaleString()} contributions from ${data.from} to ${data.to}`
				);

				for (const week of data.weeks) {
					const firstDay = new Date(`${week.first_day}T00:00:00Z`);

					for (const day of week.contribution_days) {
						const date = new Date(firstDay);
						date.setUTCDate(firstDay.getUTCDate() + day.weekday);

						const tooltip = `${day.count} contribution${day.count === 1 ? '' : 's'} on ${formatDate(date)}`;
						const square = document.createElement('span');
						square.className = 'contribution-day';
						square.style.backgroundColor =
							data.colors_full[day.level] ?? data.colors_full[0] ?? '#ebedf0';
						square.title = tooltip;
						square.setAttribute('aria-label', tooltip);
						square.tabIndex = 0;
						graph.append(square);
					}
				}

				scrollArea.append(graph);
				return scrollArea;
			}

			function buildCard(username: string, data: ContributionData): HTMLElement {
				const card = document.createElement('div');
				card.className = 'card';

				const heading = document.createElement('h2');
				heading.textContent = username;

				const total = document.createElement('p');
				total.className = 'total';
				total.textContent = data.total_contributions.toLocaleString();

				const range = document.createElement('p');
				range.className = 'range';
				range.textContent = `${data.from} → ${data.to}`;

				card.append(heading, total, range, buildGraph(data));
				return card;
			}

			function renderResults(
				player1: string,
				data1: ContributionData,
				player2: string,
				data2: ContributionData
			) {
				results.innerHTML = '';

				const cards = document.createElement('div');
				cards.className = 'cards';

				const vsBadge = document.createElement('div');
				vsBadge.className = 'vs-badge';
				vsBadge.textContent = 'VS';
				vsBadge.setAttribute('aria-hidden', 'true');

				cards.append(buildCard(player1, data1), vsBadge, buildCard(player2, data2));

				const outcome = document.createElement('p');
				outcome.className = 'outcome';

				if (data1.total_contributions > data2.total_contributions) {
					outcome.textContent = `${player1} wins!`;
				} else if (data2.total_contributions > data1.total_contributions) {
					outcome.textContent = `${player2} wins!`;
				} else {
					outcome.textContent = "It's a tie!";
				}

				results.append(cards, outcome);
			}

			for (const input of [player1Input, player2Input]) {
				input.addEventListener('input', () => {
					if (input.value.trim()) {
						input.removeAttribute('aria-invalid');
					}
				});
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				const player1 = player1Input.value.trim();
				const player2 = player2Input.value.trim();
				const player1Missing = !player1;
				const player2Missing = !player2;

				setFieldInvalidState(player1Input, player1Missing);
				setFieldInvalidState(player2Input, player2Missing);

				if (player1Missing || player2Missing) {
					showStatus('Enter a GitHub username for both players.', 'error');
					return;
				}

				button.disabled = true;
				button.textContent = 'Battling…';
				form.setAttribute('aria-busy', 'true');
				showStatus('Loading contribution data…', 'loading');

				try {
					const [data1, data2] = await Promise.all([
						fetchContributions(player1),
						fetchContributions(player2)
					]);
					renderResults(player1, data1, player2, data2);
				} catch (error) {
					showStatus(
						error instanceof Error ? error.message : 'Something went wrong.',
						'error'
					);
				} finally {
					button.disabled = false;
					button.textContent = 'Battle';
					form.removeAttribute('aria-busy');
				}
			});
		</script>
	</body>
</html>
